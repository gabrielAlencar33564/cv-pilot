{
  "name": "cv-pilot",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "dotenv -e .env -- turbo run test:integration",
    "test:e2e": "pnpm --filter @cv-pilot/e2e test:e2e",
    "lint": "turbo run lint && eslint . --ignore-pattern \"apps/\" --ignore-pattern \"packages/\"",
    "lint:fix": "turbo run lint --force -- --fix && eslint . --fix --ignore-pattern \"apps/\" --ignore-pattern \"packages/\"",
    "knip": "knip",
    "check": "pnpm db:generate && pnpm typecheck && pnpm lint && pnpm knip && pnpm test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @cv-pilot/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @cv-pilot/db migrate:dev",
    "db:seed": "dotenv -e .env -- pnpm --filter @cv-pilot/db seed && dotenv -e .env -- pnpm --filter @cv-pilot/api dev-login",
    "infra:up": "docker compose -f infra/docker/compose.dev.yaml up -d",
    "infra:down": "docker compose -f infra/docker/compose.dev.yaml down",
    "db:deploy": "dotenv -e .env -- pnpm --filter @cv-pilot/db migrate:deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "~15.5.29",
    "dotenv-cli": "^10.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "knip": "6.46.0",
    "prettier": "^3.6.2",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
