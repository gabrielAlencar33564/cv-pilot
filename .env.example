# ---------- Geral ----------
NODE_ENV=development

# ---------- Logs (api e workers) ----------
# trace | debug | info | warn | error | fatal. Use debug para ver o início e o payload de cada job.
LOG_LEVEL=info
# true = saída legível no terminal; false = JSON. Vazio: legível só com NODE_ENV=development.
LOG_PRETTY=

# ---------- Banco / filas ----------
DATABASE_URL=postgresql://cvpilot:cvpilot@localhost:5433/cvpilot?schema=public
REDIS_URL=redis://localhost:6380

# ---------- Testes de integração (pnpm test:integration) ----------
# Banco separado do de dev; o nome precisa terminar em _test. Criado e migrado pelo próprio teste.
TEST_DATABASE_URL=postgresql://cvpilot:cvpilot@localhost:5433/cvpilot_test?schema=public

# ---------- Storage S3 (SeaweedFS no Docker) ----------
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY=cvpilot
S3_SECRET_KEY=cvpilot-secret

# ---------- API ----------
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
# Chave para criptografar tokens OAuth e dados sensíveis (32 bytes em base64)
ENCRYPTION_KEY=

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- Workers ----------
# Filas que esta réplica consome (separadas por vírgula). Vazio = todas.
WORKER_QUEUES=
WORKER_CONCURRENCY=2

# ---------- IA ----------
AI_PROVIDER=
AI_API_KEY=

# ---------- Produção (Compose) ----------
DOMAIN=localhost
POSTGRES_PASSWORD=change-me
S3_SECRET_KEY_PROD=change-me-too
