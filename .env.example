# ---------- Geral ----------
NODE_ENV=development

# ---------- Logs (api e workers) ----------
# trace | debug | info | warn | error | fatal. Use debug para ver o início e o payload de cada job.
LOG_LEVEL=info
# true = saída legível no terminal; false = JSON. Vazio: legível só com NODE_ENV=development.
LOG_PRETTY=

# ---------- Banco / filas ----------
DATABASE_URL=postgresql://cvpilot:cvpilot@localhost:5433/cvpilot?schema=public
REDIS_URL=redis://localhost:6380

# ---------- Testes de integração e E2E (pnpm test:integration, pnpm test:e2e) ----------
# Banco separado do de dev; o nome precisa terminar em _test. Criado e migrado pelo próprio teste.
TEST_DATABASE_URL=postgresql://cvpilot:cvpilot@localhost:5433/cvpilot_test?schema=public
# Banco 15 do Redis de dev; as filas usam o banco 0.
TEST_REDIS_URL=redis://localhost:6380/15
# E2E (pnpm test:e2e): sem o Chromium do Playwright instalado, use o navegador da máquina
# (chrome ou msedge). Vazio = Chromium do Playwright (`pnpm --filter @cv-pilot/e2e exec playwright install chromium`)
E2E_BROWSER_CHANNEL=

# ---------- Storage S3 (SeaweedFS no Docker) ----------
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY=cvpilot
S3_SECRET_KEY=cvpilot-secret

# ---------- API ----------
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
# Login (Better Auth). URL pública das rotas de login, já com o caminho:
# em produção, https://<domínio>/api/auth (o compose já define).
BETTER_AUTH_URL=http://localhost:4000/auth
# Assina os cookies de sessão. Gere com `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Senha do usuário de dev do seed (dev@cvpilot.local). Só vale fora de produção.
DEV_USER_PASSWORD=cvpilot-dev
# Cifra (AES-256-GCM) os currículos gravados no S3 e, depois, os tokens OAuth.
# 32 bytes em base64: `openssl rand -base64 32`. Trocar a chave deixa ilegível o que já foi gravado.
ENCRYPTION_KEY=

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- Workers ----------
# Filas que esta réplica consome (separadas por vírgula). Vazio = todas.
WORKER_QUEUES=
WORKER_CONCURRENCY=2

# ---------- IA (só os workers usam) ----------
# claude = extração pelo Claude e embeddings pelo Voyage; noop = currículo vazio e sem
# embeddings (o match usa só as regras), sem chamar ninguém
AI_PROVIDER=noop
# Chave da API da Anthropic. Alternativa sem chave no .env: `ant auth login`.
ANTHROPIC_API_KEY=
# Chave do Voyage AI (embeddings da semelhança vaga × currículo). Obrigatória com AI_PROVIDER=claude.
VOYAGE_API_KEY=

# ---------- Produção (Compose) ----------
DOMAIN=localhost
POSTGRES_PASSWORD=change-me
S3_SECRET_KEY_PROD=change-me-too
