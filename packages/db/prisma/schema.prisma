generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Conta e LGPD
// ---------------------------------------------------------------------------

/// Também é o `user` do Better Auth (login): name, email, emailVerified e image são dele.
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  /// obrigatório no cadastro; nulo só em contas criadas antes do login
  name              String?
  emailVerified     Boolean   @default(false)
  image             String?
  phone             String?
  city              String?
  links             Json      @default("{}") // { linkedin, github, portfolio } (ProfileLinks em contracts)
  /// pretensão salarial mensal, em reais
  salaryExpectation Int?
  /// disponibilidade para começar, em texto livre ("imediata", "30 dias")
  availability      String?
  /// fuso IANA do usuário: define quando vira o dia do limite diário de envios
  timezone          String    @default("America/Sao_Paulo")
  role              UserRole  @default(USER)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  sessions             Session[]
  accounts             Account[]
  consents             ConsentLog[]
  searchProfiles       SearchProfile[]
  resumes              Resume[]
  coverLetterTemplates CoverLetterTemplate[]
  sendRules            SendRule[]
  applications         Application[]
  notifications        Notification[]
  oauthConnections     OAuthConnection[]
}

enum UserRole {
  USER
  ADMIN
}

/// Sessão de login (Better Auth). O token vai num cookie httpOnly.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Forma de entrar na conta (Better Auth). No login por e-mail, `providerId` é "credential" e
/// `password` guarda o hash da senha.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Códigos temporários do Better Auth (ex.: troca de e-mail). Não pertencem a um usuário.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model ConsentLog {
  id           String   @id @default(cuid())
  userId       String
  termsVersion String
  acceptedAt   DateTime @default(now())
  ip           String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthConnection {
  id              String   @id @default(cuid())
  userId          String
  provider        String // gmail | outlook | linkedin
  accountEmail    String
  /// tokens criptografados (AES-GCM) com ENCRYPTION_KEY
  encryptedTokens String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, accountEmail])
}

// ---------------------------------------------------------------------------
// Fontes (sites de vagas). Cada registro corresponde a um adapter.
// ---------------------------------------------------------------------------

model Source {
  id            String   @id // "gupy", "greenhouse", "lever", "linkedin"...
  displayName   String
  kind          String // api | html | browser
  applyModes    String[] // api | email | assisted
  active        Boolean  @default(true)
  rateLimitReqs Int      @default(30)
  rateLimitMs   Int      @default(60000)
  lastRunAt     DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobSources   JobSource[]
  careerBoards CareerBoard[]
  runs         SourceRun[]
  sendRules    SendRule[]
  applications Application[]
}

/// Catálogo de empresas das fontes que buscam por empresa (Greenhouse, Lever):
/// cada board é baixado uma vez por janela, para todos os usuários.
model CareerBoard {
  id            String    @id @default(cuid())
  sourceId      String
  /// identificador da empresa no ATS: board token do Greenhouse, slug do Lever
  token         String
  active        Boolean   @default(true)
  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  source     Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  jobSources JobSource[]
  runs       SourceRun[]

  @@unique([sourceId, token])
  @@index([sourceId, active])
}

/// Uma tentativa de ingestão (RF-80): cada execução de um job `ingest`, com o resultado.
/// Alimenta a saúde das fontes no admin; o scheduler apaga as antigas.
model SourceRun {
  id            String   @id @default(cuid())
  sourceId      String
  careerBoardId String?
  /// board token ou palavra-chave baixada
  target        String
  /// success | failed | blocked | rate_limited (SourceRunStatus em contracts)
  status        String
  found         Int      @default(0)
  changed       Int      @default(0)
  matches       Int      @default(0)
  closed        Int      @default(0)
  error         String?
  startedAt     DateTime
  durationMs    Int

  source      Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  careerBoard CareerBoard? @relation(fields: [careerBoardId], references: [id], onDelete: SetNull)

  @@index([sourceId, startedAt])
  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// Perfis de busca
// ---------------------------------------------------------------------------

model SearchProfile {
  id                String   @id @default(cuid())
  userId            String
  name              String
  keywords          String[]
  excludeKeywords   String[]
  seniorities       String[]
  workModels        String[]
  contractTypes     String[]
  location          String?
  radiusKm          Int?
  salaryMin         Int?
  salaryMax         Int?
  companyBlacklist  String[]
  sourceIds         String[]
  frequencyMinutes  Int      @default(360)
  dailyApplyLimit   Int      @default(10)
  minScoreAutoApply Int      @default(75)
  active            Boolean  @default(true)
  lastSearchedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sendRules    SendRule[]
  matches      JobMatch[]
  applications Application[]

  @@index([userId])
  @@index([active])
}

// ---------------------------------------------------------------------------
// Currículos e personalização por site
// ---------------------------------------------------------------------------

model Resume {
  id          String   @id @default(cuid())
  userId      String
  name        String // "CV Técnico", "CV Humanizado"
  description String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions  ResumeVersion[]
  sendRules SendRule[]

  @@index([userId])
}

model ResumeVersion {
  id          String                       @id @default(cuid())
  resumeId    String
  version     Int
  storageKey  String // chave do arquivo cifrado no S3 (@cv-pilot/storage)
  fileName    String
  mimeType    String
  /// dados extraídos pela IA (ParsedResume em @cv-pilot/contracts)
  parsed      Json?
  /// pending | parsed | failed (ResumeParseStatus em @cv-pilot/contracts)
  parseStatus String                       @default("pending")
  /// motivo da falha (ResumeParseFailure); nunca guarda conteúdo do currículo
  parseError  String?
  parsedAt    DateTime?
  embedding   Unsupported("vector(1024)")?
  createdAt   DateTime                     @default(now())

  resume       Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applications Application[]

  // Índice HNSW em embedding: SQL manual na migration embeddings_1024_and_search_indexes.
  @@unique([resumeId, version])
}

model CoverLetterTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  body      String // suporta variáveis: {{empresa}}, {{cargo}}, {{nome}}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sendRules SendRule[]
}

/// Regra de envio. sourceId/searchProfileId nulos = escopo mais geral.
/// Precedência resolvida em @cv-pilot/core (resolveSendRule).
model SendRule {
  id                    String   @id @default(cuid())
  userId                String
  sourceId              String?
  searchProfileId       String?
  resumeId              String
  coverLetterTemplateId String?
  generateCoverLetter   Boolean  @default(false)
  tone                  String   @default("technical")
  mode                  String   @default("assisted")
  reviewBeforeSend      Boolean  @default(true)
  defaultAnswers        Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  source              Source?              @relation(fields: [sourceId], references: [id])
  searchProfile       SearchProfile?       @relation(fields: [searchProfileId], references: [id], onDelete: Cascade)
  resume              Resume               @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  coverLetterTemplate CoverLetterTemplate? @relation(fields: [coverLetterTemplateId], references: [id], onDelete: SetNull)

  // No banco este índice é NULLS NOT DISTINCT (SQL manual na migration
  // embeddings_1024_and_search_indexes): sem isso, escopos com NULL não conflitariam.
  @@unique([userId, searchProfileId, sourceId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Vagas, matching e candidaturas
// ---------------------------------------------------------------------------

model Job {
  id           String                       @id @default(cuid())
  dedupeHash   String                       @unique
  title        String
  company      String
  location     String?
  workModel    String?
  seniority    String?
  contractType String?
  salaryMin    Int?
  salaryMax    Int?
  description  String
  applyEmail   String?
  publishedAt  DateTime?
  active       Boolean                      @default(true)
  embedding    Unsupported("vector(1024)")?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  sources      JobSource[]
  matches      JobMatch[]
  applications Application[]

  // Índices que o Prisma não expressa, criados em SQL na migration
  // embeddings_1024_and_search_indexes: HNSW em embedding e GIN de full-text em title + description.
  @@index([active, publishedAt])
}

/// A mesma vaga pode aparecer em várias fontes.
model JobSource {
  id         String   @id @default(cuid())
  jobId      String
  sourceId   String
  externalId String
  url        String
  raw           Json?
  /// board de onde a vaga veio, nas fontes por empresa; permite expirar o que sumiu dele
  careerBoardId String?
  firstSeen     DateTime  @default(now())
  lastSeen      DateTime  @default(now())
  /// a vaga saiu da fonte (RF-34); volta a null se ela reaparecer
  closedAt      DateTime?

  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source      Source       @relation(fields: [sourceId], references: [id])
  careerBoard CareerBoard? @relation(fields: [careerBoardId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId])
  @@index([jobId])
  @@index([careerBoardId, lastSeen])
  @@index([closedAt, lastSeen])
}

model JobMatch {
  id              String   @id @default(cuid())
  jobId           String
  searchProfileId String
  score           Int
  reasons         String[]
  dismissed       Boolean  @default(false)
  /// por que o usuário marcou "não tenho interesse" (DismissReason em contracts, RF-42)
  dismissedReason String?
  createdAt       DateTime @default(now())

  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  searchProfile SearchProfile @relation(fields: [searchProfileId], references: [id], onDelete: Cascade)

  @@unique([jobId, searchProfileId])
  @@index([searchProfileId, score])
}

model Application {
  id              String    @id @default(cuid())
  userId          String
  jobId           String
  sourceId        String
  searchProfileId String?
  resumeVersionId String
  sendRuleId      String?
  mode            String // api | email | assisted
  status          String    @default("suggested")
  score           Int?
  coverLetter     String?
  answers         Json      @default("{}")
  log             Json      @default("[]") // eventos do envio
  notes           String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job            @relation(fields: [jobId], references: [id])
  source        Source         @relation(fields: [sourceId], references: [id])
  searchProfile SearchProfile? @relation(fields: [searchProfileId], references: [id], onDelete: SetNull)
  resumeVersion ResumeVersion  @relation(fields: [resumeVersionId], references: [id])

  @@unique([userId, jobId])
  @@index([userId, status])
}

/// Alerta dentro do app (RF-70/71), no lugar do e-mail por enquanto. `data` guarda só ids e
/// contagens (formatos em contracts/notification.ts), nunca dado pessoal.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // needs_action | resume_parse_failed | new_jobs
  data      Json      @default("{}")
  /// o mesmo alerta não entra duas vezes quando o job do notify roda de novo
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}
